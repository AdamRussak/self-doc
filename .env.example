# Copy to .env and fill in real values. .env is gitignored — never commit it.

# --- System / Timezone ---
# Optional — timezone for container logs and scheduled sync tasks (defaults to Asia/Jerusalem if unset).
# TZ=Asia/Jerusalem

# --- Postgres / pgvector ---
# Generate the password, do not invent one by hand: `openssl rand -hex 32`.
# It is only ever used container-to-container over the `self-docs-internal`
# network, so length costs you nothing.
POSTGRES_USER=self_docs
POSTGRES_PASSWORD=REPLACE_ME_WITH_A_GENERATED_PASSWORD
POSTGRES_DB=self_docs

# --- Traefik ---
# Hostname the mcp-server is routed from (e.g. docs-mcp.lan.example.com)
DOCS_MCP_HOSTNAME=docs-mcp.example.lan
# Name of the pre-existing external Traefik docker network to join
TRAEFIK_NETWORK=traefik_proxy
# Traefik entrypoint the mcp-server router attaches to. Home-lab convention is
# a TLS-terminated `websecure`; set to `web` (or your own name) if this LAN's
# Traefik has no TLS resolver configured for this router.
TRAEFIK_ENTRYPOINT=websecure

# --- Ingestion auth ---
# Required. Generate it — do NOT ship the placeholder below:
#
#     openssl rand -hex 32
#
# This ONE token guards `POST /sync`, `POST /refresh`, the DESTRUCTIVE
# `POST /purge`, and the whole `/admin` UI (login + source delete). The
# ingestion service refuses to start if it is unset; it also refuses to start
# if it is left at a known placeholder value (like the one below) while
# SELF_DOCS_LISTENERS declares any non-loopback address — on a loopback-only
# box it warns instead. Rotation procedure: docs/runbook.md, "Rotate
# SYNC_TOKEN". Rotating it invalidates every existing /admin session cookie.
SYNC_TOKEN=REPLACE_ME_WITH_A_GENERATED_TOKEN

# --- MCP server auth ---
# Required — the mcp-server refuses to start without this, and every request
# must send `Authorization: Bearer $MCP_TOKEN`. Generate it the same way
# (`openssl rand -hex 32`) and use a DIFFERENT value from SYNC_TOKEN: this one
# is handed out to every MCP client (see docs/client-setup.md), so it has a
# much wider distribution than the admin/ingestion token.
MCP_TOKEN=REPLACE_ME_WITH_A_GENERATED_TOKEN

# --- Declared exposure (security check input) ---
# Comma-separated list of the addresses this deployment is ACTUALLY reachable
# on. Feeds the ingestion service's boot-time placeholder-token check: any
# non-loopback entry here turns a placeholder SYNC_TOKEN from a warning into a
# refusal to start. Leave it unset for a plain loopback-only `make up`; the
# base docker-compose.yml already defaults it to `127.0.0.1:8080`, and
# docker-compose.prod.yml overrides it with the Traefik hostname. Set it here
# only if you expose the service some other way (your own nginx/caddy, an
# extra published port, a VPN address):
#   SELF_DOCS_LISTENERS=127.0.0.1:8080,https://docs.example.lan/api/v1

# --- Embedding model (managed by `make configure`) ---
# These are written/overwritten by `make configure MODEL=<name>`, which resolves
# them from config/models.yaml (the single source of truth). You normally do NOT
# edit them by hand — run `make configure` to switch models, then `make reindex`.
# The values below are the registry default (mixedbread-ai/mxbai-embed-large-v1);
# both services fall back to these defaults if the vars are unset.
#   EMBEDDING_MODEL_NAME=mixedbread-ai/mxbai-embed-large-v1
#   EMBEDDING_DIM=1024                 # MUST match db/init/01_schema.sql's vector(N)
#   EMBEDDING_QUERY_PROMPT=Represent this sentence for searching relevant passages:
#   EMBEDDING_PASSAGE_PROMPT=          # empty for mxbai/bge; "passage: " for e5
#   INGESTION_MEM_LIMIT=2g             # docker-compose memory limit, sized per model
#   MCP_MEM_LIMIT=2g
