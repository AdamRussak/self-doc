# self-docs standalone deployment kit — environment file.
#
# Copy this to `.env` in the same directory as docker-compose.yml, fill in
# the REPLACE_ME_* secrets, and confirm EMBEDDING_MODEL_NAME/EMBEDDING_DIM
# match both SELF_DOCS_IMAGE_TAG and the vector(N) column you rendered into
# db/init/01_schema.sql before first boot. See deploy/models.tsv for the
# full model -> tag -> dimension -> memory-limit mapping.
#
# Container and network names are intentionally NOT set anywhere in this kit
# (see docker-compose.yml) — Compose derives them from the install
# directory's name instead, so one install never collides with the
# from-source repo-root stack or with another install of this same kit
# running a different model. Running more than one install on the same host
# and want explicit, predictable names instead of the directory-derived
# default? Set `COMPOSE_PROJECT_NAME=<name>` in this file (or pass
# `docker compose -p <name>` on the command line) per install.

# --- Image selection -------------------------------------------------------

# GHCR namespace the images are published under. One tag drives BOTH
# ingestion and mcp-server so they always run the same embedding model.
SELF_DOCS_OWNER=adamrussak

# Model slug tag — NEVER "latest". A moving `latest` tracks the registry's
# current default model, which can change in a future release and would
# silently swap the embedding model under an existing database. Pin a slug
# and change it deliberately (with a matching schema re-render).
SELF_DOCS_IMAGE_TAG=bge-small-en-v1.5

# --- Postgres ----------------------------------------------------------

POSTGRES_USER=self_docs
# REPLACE_ME: set a real password before first boot — never ship this as a
# committed secret.
POSTGRES_PASSWORD=REPLACE_ME_POSTGRES_PASSWORD
POSTGRES_DB=self_docs

# --- Shared secrets ------------------------------------------------------

# REPLACE_ME: bearer token guarding ingestion's /sync, /refresh, /purge, and
# the /admin UI login. Loopback-only binding in this kit makes a placeholder
# value survivable, but still replace it — see ingestion/app/security.py.
SYNC_TOKEN=REPLACE_ME_SYNC_TOKEN
# REPLACE_ME: bearer token guarding the mcp-server's MCP endpoint. Unlike
# SYNC_TOKEN, mcp-server only checks this is non-empty at boot, not that
# it's a real (non-placeholder) secret, and it has no SELF_DOCS_LISTENERS
# equivalent to escalate that check if you later expose this service —
# see docker-compose.yml's comment on this variable before doing so.
MCP_TOKEN=REPLACE_ME_MCP_TOKEN

# --- Embedding model -----------------------------------------------------

# Must match the model baked into SELF_DOCS_IMAGE_TAG above.
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
# Must match the model's output dimension AND the vector(N) column you
# rendered into db/init/01_schema.sql.
EMBEDDING_DIM=384
# Quoted (not bare) so the trailing space survives `docker compose` variable
# resolution — that trailing space is semantically significant, both
# services prepend this string directly to the passage/query text.
EMBEDDING_PASSAGE_PROMPT=""
EMBEDDING_QUERY_PROMPT="Represent this sentence for searching relevant passages: "

# --- Resource limits -------------------------------------------------------

# Per-model recommended values — see deploy/models.tsv. These defaults match
# the registry-default model (bge-small-en-v1.5).
INGESTION_MEM_LIMIT=1500m
MCP_MEM_LIMIT=1g

# --- Ports (bound to 127.0.0.1 only — no reverse proxy ships with this kit) -

SELF_DOCS_API_PORT=8080
SELF_DOCS_MCP_PORT=8081

# --- Misc --------------------------------------------------------------

TZ=Asia/Jerusalem
